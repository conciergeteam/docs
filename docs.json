{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Product Guide",
  "description": "How to use the Concierge associate app: people, lists, broadcasts, inbox, and event settings.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "redirects": [
    {
      "source": "/broadcasts",
      "destination": "/platform/broadcasts"
    }
  ],
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Events",
        "icon": "house",
        "expanded": true,
        "pages": ["platform/events"]
      },
      {
        "group": "People",
        "icon": "users",
        "expanded": true,
        "pages": ["platform/people", "platform/person"]
      },
      {
        "group": "Lists",
        "icon": "list",
        "pages": ["platform/lists"]
      },
      {
        "group": "Messaging",
        "icon": "message-square",
        "pages": ["platform/broadcasts", "platform/inbox"]
      },
      {
        "group": "Calls and reports",
        "icon": "phone",
        "pages": ["platform/calls", "platform/reports"]
      },
      {
        "group": "Event website",
        "icon": "globe",
        "pages": [
          "platform/schedule",
          "platform/faqs",
          "platform/directory",
          "platform/appointments",
          "platform/sign-up",
          "platform/support"
        ]
      },
      {
        "group": "Event settings",
        "icon": "settings",
        "pages": [
          "platform/settings/name-location",
          "platform/settings/dates-times",
          "platform/settings/calls",
          "platform/settings/auto-reply",
          "platform/settings/qr-code",
          "platform/settings/contact-card",
          "platform/settings/keywords",
          "platform/settings/message-topics",
          "platform/settings/assignment-rules",
          "platform/settings/notifications",
          "platform/settings/phone-numbers",
          "platform/settings/ai",
          "platform/settings/brand",
          "platform/settings/schedule",
          "platform/settings/directory",
          "platform/settings/appointments",
          "platform/settings/translation",
          "platform/settings/export",
          "platform/settings/people-properties"
        ]
      },
      {
        "group": "Account",
        "icon": "user",
        "pages": [
          "account/account",
          "account/team",
          "account/templates",
          "account/advanced"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dash.conciergeteam.co"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  }
}
